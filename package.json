{
  "name": "betty-mcp",
  "version": "0.5.0",
  "description": "Betty — an assistant layer for agentic platforms. Email, calendar, tasks, contacts, notes, memory, and skills, stored in your own file storage.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "betty-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "count-tokens": "npm run build && node scripts/count-tool-tokens.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samteezy/Betty"
  },
  "keywords": [
    "mcp",
    "email",
    "imap",
    "jmap",
    "fastmail",
    "caldav",
    "carddav",
    "calendar",
    "contacts",
    "webdav",
    "notes",
    "memory",
    "skills"
  ],
  "author": "Sam Taylor",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2",
    "zod-to-json-schema": "^3.25.2"
  }
}
